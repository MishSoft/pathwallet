# Database connection URL for Neon/PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DB>?sslmode=require
# Secret key for JWT signing. Use a long random string.
JWT_SECRET_KEY=your_jwt_secret_key
# Gemini API key for AI integration.
GEMINI_API_KEY=your_gemini_api_key
# Email address used as sender for outgoing emails.
EMAIL_USER=your_email@example.com
# Email password or app-specific password (optional, keep commented if using API).
# EMAIL_PASS=your_email_password
# SendGrid API key for email delivery.
SENDGRID_API_KEY=your_sendgrid_api_key
